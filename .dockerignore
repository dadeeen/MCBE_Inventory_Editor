# Docker patterns are relative to the context root. Use ** for local
# artifacts that must also be excluded inside copied source directories.

# Python and tool caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.pytest-*/
**/.ruff_cache/
**/.mypy_cache/
**/.pip-tools-cache/
**/.lockcheck/
**/.tmp/
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov/
**/diagnostics/

# Local logs and OS/editor noise
**/*.log
**/*.log.*
**/*.jsonl
**/*.jsonl.*
**/*.tmp
**/*.rollback
**/*.transaction.json
**/.operation_locks/
**/*.bak
**/*.orig
**/*.swp
**/*~
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Local virtual environments
**/.venv/
**/venv/
**/node_modules/

# Local secrets and machine-specific configuration
**/.env
**/.env.*
!**/.env.example

# Git metadata
**/.git/

# Local browser, editor and development-tool state
**/.agents/
**/.claude/
**/.codex/
**/.idea/
**/.playwright-cli/
**/.vscode/
**/test-results/
**/playwright-report/

# CI, tests and development-only material are not runtime image inputs
**/.github/
**/docs/
**/.engine-tests/
scripts/engine_checks/
**/fixtures/
**/tests/
**/package.json
**/package-lock.json
**/playwright.config.mjs
requirements/*.in
requirements/README.md

# Portable app/runtime data
**/data/
**/setup.json
**/settings.json
**/backup_settings.json
**/source_version.json
**/source_version_history.json
cache/item_update/
**/.cache_item_update/

# Generated backups and player exports
**/*_backups/
**/*_restoring/
**/*_restoring_*/
**/*_rollback_/
**/*_rollback_*/
**/player_exports/
**/*.mcbe-player.zip
**/*.mcbe-player-bundle.zip
**/player_raw_export_index.json

# Build and release artifacts
**/dist/
**/wheels/
**/RELEASE_MANIFEST.json
**/*.zip

# Private Bedrock worlds / fixture staging
fixtures/private/
**/private/
**/*.mcworld
**/*.mcpack
**/*.mcaddon
**/Sample-World.zip
**/*.private.fixture.zip
**/*.metadata-sanitized.zip

# Vendored upstream assets when staged locally
**/vendor

# Server binaries and the obsolete generated catalog are not app inputs.
**/bedrock_server
**/bedrock_server.exe
**/item_db.py

# Docker globs are case-sensitive, including on Linux hosts building a Windows
# checkout. Ordered case-insensitive companions cover every exclusion above,
# including private directories, archives and developer state. Keep the readable
# rules and this companion list aligned; character classes use Docker glob syntax.
**/__[pP][yY][cC][aA][cC][hH][eE]__/
**/*.[pP][yY][cCoOdD]
**/.[pP][yY][tT][eE][sS][tT]_[cC][aA][cC][hH][eE]/
**/.[pP][yY][tT][eE][sS][tT]-*/
**/.[rR][uU][fF][fF]_[cC][aA][cC][hH][eE]/
**/.[mM][yY][pP][yY]_[cC][aA][cC][hH][eE]/
**/.[pP][iI][pP]-[tT][oO][oO][lL][sS]-[cC][aA][cC][hH][eE]/
**/.[lL][oO][cC][kK][cC][hH][eE][cC][kK]/
**/.[tT][mM][pP]/
**/.[cC][oO][vV][eE][rR][aA][gG][eE]
**/.[cC][oO][vV][eE][rR][aA][gG][eE].*
**/[cC][oO][vV][eE][rR][aA][gG][eE].[xX][mM][lL]
